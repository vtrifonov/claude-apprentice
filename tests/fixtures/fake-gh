#!/bin/sh
# Stand-in for gh: FAKE_GH_MODE=public|private|sleep|missing-json answers `repo view --json visibility`.
# FAKE_GH_LOG, when set, gets one line of arguments per call.
if [ -n "${FAKE_GH_LOG:-}" ]; then
    printf '%s\n' "$*" >> "$FAKE_GH_LOG"
fi
case "${FAKE_GH_MODE:-}" in
    public) printf '{"visibility": "PUBLIC"}\n'; exit 0 ;;
    private) printf '{"visibility": "PRIVATE"}\n'; exit 0 ;;
    sleep) sleep 10; exit 0 ;;
    missing-json) printf '{}\n'; exit 0 ;;
esac
exit 1
